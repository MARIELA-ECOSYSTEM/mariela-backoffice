# Ambiente TEMPORÁRIO (preview e publicado): usa a API mockada, pois a API
# NestJS remota ainda não está disponível. Ao conectar o backend, defina
# VITE_API_URL e troque VITE_USE_MOCK_API para "false".
VITE_USE_MOCK_API=true

# VITE_API_URL=https://api.mariela.com/api/v1

# Credenciais do ambiente MOCK — exclusivamente fictícias, nunca a credencial
# real do administrador de produção (Etapa 20.07: a credencial real estava
# incorporada ao bundle frontend através destas variáveis).
VITE_MOCK_LOGIN=mock@mariela.local
VITE_MOCK_SENHA=mock-dev-2026
