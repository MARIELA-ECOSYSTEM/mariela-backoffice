# Endereço remoto da API REST (NestJS + MongoDB).
# A aplicação Desktop (Tauri) consome a API pela internet — nunca use host fixo no código.
VITE_API_URL=https://api.mariela.com/api/v1

# Desenvolvimento contra a API local:
# VITE_API_URL=http://localhost:3000/api/v1

# "true" força a API mockada; "false" força a API real.
# Sem valor: mock apenas quando VITE_API_URL não está definido.
VITE_USE_MOCK_API=false

# Credenciais aceitas pela API mockada (somente ambiente MOCK).
VITE_MOCK_LOGIN=admin
VITE_MOCK_SENHA=123456
