{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MARIELA Backoffice",
  "version": "0.1.2",
  "identifier": "com.mariela.backoffice",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "bun run build:desktop",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "MARIELA Backoffice",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' https:",
        "connect-src": "'self' ipc: http://ipc.localhost https://mariela-backend.onrender.com https://api.github.com https://*.r2.cloudflarestorage.com",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
